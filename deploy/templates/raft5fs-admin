#!/bin/sh
# raft5fs-admin: filesystem administration on this node, with the
# credentials installed here. Run as root.
#
#   raft5fs-admin user add <NAME> [--no-volumes] [--invite] [--links]
#                                          an invitation to enrol with
#   raft5fs-admin user set <NAME> [--volumes on|off] [--invite on|off] [--links on|off]
#   raft5fs-admin user del <NAME>
#   raft5fs-admin user list
#   raft5fs-admin snapshot create [<NAME>]
#   raft5fs-admin snapshot del <NAME>
#   raft5fs-admin snapshot list
#   raft5fs-admin backup create <SNAPSHOT>
#   raft5fs-admin backup del <NAME>
#   raft5fs-admin backup list
#   raft5fs-admin backup restore-objects <NAME>
#
# Every command uses the filesystem servers' store account, which is in
# backup-operators. `backup` needs cluster.conf's BACKUP_* settings.
set -eu
STORE="--store-ca /etc/raft5fs/internal-ca.pem --store-cert /etc/raft5fs/node.pem --store-key /etc/raft5fs/node.key"
# Every store node, unless RAFT5FS_SEEDS gives others.
SEEDS="${RAFT5FS_SEEDS:-@SEEDS@}"

case ${1:-} in
user | snapshot)
    . /etc/raft5fs/store.env
    export RAFT5FS_STORE_PASSWORD
    if [ "$1 ${2:-}" = "user add" ]; then
        # shellcheck disable=SC2086
        set -- "$@" @INVITE_SERVERS@--invite-ca /etc/raft5fs/fs-ca.pem
    fi
    # shellcheck disable=SC2086
    exec /usr/local/bin/raft5fs-server "$@" --store-user raft5fs $STORE $SEEDS
    ;;
backup)
    [ -f /etc/raft5fs/backup.env ] || {
        echo "no backup space set up: set BACKUP_BUCKET in cluster.conf" >&2
        exit 1
    }
    set -a
    . /etc/raft5fs/store.env
    . /etc/raft5fs/backup.env
    set +a
    # shellcheck disable=SC2086
    exec /usr/local/bin/raft5fs-server "$@" --store-user raft5fs $STORE \
        @OBJECT_OPTIONS@@BACKUP_OPTIONS@$SEEDS
    ;;
*)
    sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
