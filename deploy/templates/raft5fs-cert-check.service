# Fails (shown in `systemctl --failed` and the journal) when any certificate
# that the servers use expires within 30 days. raft5fs-cert-check.timer runs
# it daily. Renew with deploy/certs.sh renew.
[Unit]
Description=Check the raft5fs certificates aren't about to expire

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/raft5fs-cert-check 30
