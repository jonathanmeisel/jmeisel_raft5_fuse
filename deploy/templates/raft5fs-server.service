# The raft5fs filesystem server on @NODE@. deploy/render.sh renders this
# file. The server is stateless: it serves users on the public port (and
# browsers on the web port, with the web app on) and keeps everything in
# the store, through whichever store node answers. So it needs the store
# to run, but not this node's store node. It cannot log in until the store
# is bootstrapped, so systemd restarts it until then.
[Unit]
Description=raft5fs filesystem server
After=raft5-server.service wg-quick@wg0.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=raft5fs
Group=raft5fs
# RAFT5FS_STORE_PASSWORD is the store account's password. With object
# storage, RAFT5FS_OBJECT_ACCESS_KEY and RAFT5FS_OBJECT_SECRET_KEY are the
# bucket's credentials. systemd reads the file as root, and only root can
# read it.
EnvironmentFile=/etc/raft5fs/store.env
ExecStart=/usr/local/bin/raft5fs-server --listen 0.0.0.0:27060 \
    --token-key-file /etc/raft5fs/token.key \
    --tls-cert /etc/raft5fs/fs.pem --tls-key /etc/raft5fs/fs.key \
    --chunk-size @CHUNK_SIZE@ @OBJECT_OPTIONS@@WEB_OPTIONS@\
    @INVITE_SERVERS@--invite-ca /etc/raft5fs/fs-ca.pem \
    --store-user raft5fs --store-ca /etc/raft5fs/internal-ca.pem \
    --store-cert /etc/raft5fs/node.pem --store-key /etc/raft5fs/node.key \
    @SEEDS@
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
