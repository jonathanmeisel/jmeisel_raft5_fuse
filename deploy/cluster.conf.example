# The cluster's layout. Copy it to <cluster repo>/<cluster>/cluster.conf
# and edit it (README "Secrets"). Every script here reads it, from
# RAFT5FS_CLUSTER. Shell syntax.

# One line per node:  <name> <public IP> <WireGuard IP> <public DNS name or ->
#
# <name> is also the store node's raft id, which must never change after the
# cluster is bootstrapped. The cluster is bootstrapped on the first node
# listed. Users connect to each node at its DNS name if it has one, or else
# at its public IP. The filesystem servers' certificate covers both.
NODES="
node1 203.0.113.11 10.10.0.1 fs1.example.com
node2 203.0.113.12 10.10.0.2 fs2.example.com
node3 203.0.113.13 10.10.0.3 fs3.example.com
"

# How install.sh and the other scripts log in to the nodes. Needs root, or
# sudo without a password.
SSH_USER=root
# The port that sshd listens on, which the firewall keeps open. If this is
# wrong, install.sh locks you out.
SSH_PORT=22

# The port that WireGuard listens on, between the nodes.
WG_PORT=51820

# Where the raft5 store's source is checked out. build.sh builds
# raft5-server and the `raft` admin shell from there. A relative path is
# relative to the raft5fs repo's deploy/ directory.
RAFT5_REPO=../../jmeisel_raft5

# The filesystem's chunk size. The first server sets it when it creates the
# filesystem, and it never changes (see SETUP.txt section 4).
CHUNK_SIZE=1M

# Large files in an S3-compatible bucket (README "Creating and deploying
# a new cluster", step 5; SETUP.txt section 12). Optional: leave S3_BUCKET
# empty to keep everything in the store. The credentials go in the
# cluster's secrets (./secrets.sh edit s3.env), never here.
S3_BUCKET=
S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_REGION=eu-west-1
# yes for MinIO and most self-hosted stores (<endpoint>/<bucket>/ URLs).
S3_PATH_STYLE=no
S3_PREFIX=raft5fs/
# Where in a file its data starts to go to the bucket, and how much data
# each object holds (a whole number of chunks). The first server that uses
# them sets both, and they never change.
OBJECT_FROM=10M
OBJECT_BLOCK=16M
# How often, in seconds, to delete objects that nothing points to.
GC_INTERVAL=3600

# Backups of snapshots to another S3-compatible bucket (README "Backup and
# recovery"). Optional: leave BACKUP_BUCKET empty for none. It must not be
# S3_BUCKET. The credentials go in the cluster's secrets (./secrets.sh edit
# backup.env), and the operator public key in its secrets/backup.pub,
# never here.
BACKUP_BUCKET=
BACKUP_ENDPOINT=https://s3.eu-west-1.amazonaws.com
BACKUP_REGION=eu-west-1
BACKUP_PATH_STYLE=no
BACKUP_PREFIX=raft5fs-backup/
# Take a backup every night on the nodes, as nightly-<date>, and keep the
# newest BACKUP_KEEP of them (README "Backup and recovery").
NIGHTLY_BACKUPS=no
BACKUP_KEEP=14

# Hardening (README "Creating and deploying a new cluster", step 10).
# ADMIN_USER is a sudo user that accepts the SSH keys in the cluster's
# authorized_keys file. Once logging in as it works, set SSH_USER to it,
# then SSH_HARDEN=yes: SSH keys only, and no root login.
ADMIN_USER=
SSH_HARDEN=no

# A swap file of this size on each node (e.g. 1G), so a memory spike, such
# as a large backup, slows a node down rather than getting raft5-server
# killed. Empty: leave swap as it is.
SWAP_SIZE=

# How long the certificates that certs.sh issues are valid, in days. The CAs
# are valid for ten years.
CERT_DAYS=397
